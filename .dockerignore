# Build context for the core image is the repo root. Keep the host's local
# artifacts out so the image builds its OWN venv (gunicorn baked in via the
# Dockerfile's `uv sync --group cloud`, no host .venv leaking in / runtime
# re-install) and stays small + reproducible.
.venv
**/.venv
.git
.github
**/__pycache__
**/*.pyc
.ruff_cache
**/.ruff_cache
.idea
.vscode
.DS_Store

# Secrets, mirroring .gitignore's secret paths: the env files and the
# inline provider keys. `COPY . /app` would bake them into a layer, and
# wsgi.py's load_dotenv() would then satisfy the unset-DJANGO_ENV
# refusal from inside the image. The compose bind mount supplies both at
# runtime; they never enter a layer. A new gitignored secret path needs
# a line here too.
**/.env
**/.env.*
!**/.env.example
config/*
!config/templates/
!config/README.md

# The core (uv/Python) image doesn't need the web pnpm workspace at all.
web
