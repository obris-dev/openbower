# Selects the settings module (conf.settings.<env>). ALWAYS explicit:
# unset refuses to start, so "cloud" only ever runs because a deploy wrote
# it down. This file sets "local", the profile for the repo running on
# your own machine.
DJANGO_ENV=local
DJANGO_SECRET_KEY=local-only-change-me

# conf.settings.local seeds all of these dev defaults; uncomment to override.
# BASE_URL=http://localhost:8002               this backend (OAuth redirect_uri host)
# APP_BASE_URL=http://localhost:3003           the web app (post-login redirect + CORS origin)
# OPENBOWER_AUTH_URL=http://localhost:8001     the openbower-auth IdP (identity)
# OPENBOWER_DATA_URL=http://localhost:8003     the data service behind look-alike discovery (identity)
# OAUTH_CLIENT_ID=openbower-app                public client id registered at the IdP

# Server-to-server transport overrides. The canonical URLs above stay the
# services' identity (browser navigation, token resource indicators); these
# carry only the HTTP calls this process makes itself, for when its network
# path differs from the browser's (docker-compose sets them for the
# containerized stack). Default: the canonical URL.
# OPENBOWER_AUTH_INTERNAL_URL=http://localhost:8001
# OPENBOWER_DATA_INTERNAL_URL=http://localhost:8003

# Tunables (defaulted in base settings; uncomment to override).
# AUTH_ACCESS_TOKEN_REFRESH_SKEW_SECONDS=30    rotate the IdP access token this early (>=1)
# AUTH_REFRESH_COOLDOWN_SECONDS=30             refresh back-off during an IdP blip (>=1)

# Postgres (docker-compose db, host port 5433). Dev creds; set explicitly
# for any real deploy. The password is required by base settings.
# POSTGRES_DB=openbower
# POSTGRES_USER=openbower
# POSTGRES_PASSWORD=openbower
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433

# Agents: inference sources (structure AND keys) live in ONE place,
# config/providers.toml (gitignored; copy
# config/templates/providers.example.toml and edit). No env mirror.
# Local runs add a keyless "ollama" source automatically.
# PROVIDERS_CONFIG=/path/to/providers.toml  # override the config file path (empty falls back to config/providers.toml)

# Agents: the search seam behind the evidence tools. Web search runs
# through DuckDuckGo by DEFAULT (free, keyless, zero setup; it can
# rate-limit under heavy load). CONTACT search always needs DataForSEO
# (pay-as-you-go Google SERPs, non-expiring balance, $1 trial credit):
# set its credentials and that tool opens. SEARCH_PROVIDER=dataforseo
# routes web search through it too (Google-grade results, dedicated
# throughput).
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# SEARCH_PROVIDER=duckduckgo

# Cloud profile only: where a crashed test run points its user
# ("contact OpenBower support" when unset). Local says "check the API
# server's logs" and ignores this.
# SUPPORT_HINT=
