# Selects the settings module (conf.settings.<env>). ALWAYS explicit:
# unset refuses to start, so "cloud" only ever runs because a deploy wrote
# it down. This file sets "local", the profile for the repo running on
# your own machine.
DJANGO_ENV=local
DJANGO_SECRET_KEY=local-only-change-me

# conf.settings.local seeds all of these dev defaults; uncomment to override.
# BASE_URL=http://localhost:8002               this backend (OAuth redirect_uri host)
# APP_BASE_URL=http://localhost:3003           the web app (post-login redirect + CORS origin)
# OPENBOWER_AUTH_URL=http://localhost:8001     the openbower-auth IdP
# OAUTH_CLIENT_ID=openbower-app                public client id registered at the IdP

# Tunables (defaulted in base settings; uncomment to override).
# AUTH_ACCESS_TOKEN_REFRESH_SKEW_SECONDS=30    rotate the IdP access token this early (>=1)
# AUTH_REFRESH_COOLDOWN_SECONDS=30             refresh back-off during an IdP blip (>=1)

# Postgres (docker-compose db, host port 5433). Dev creds; set explicitly
# for any real deploy. The password is required by base settings.
# POSTGRES_DB=openbower
# POSTGRES_USER=openbower
# POSTGRES_PASSWORD=openbower
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
