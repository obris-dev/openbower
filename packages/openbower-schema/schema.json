{
  "$defs": {
    "AuthUser": {
      "description": "The authenticated user the app's /v1/auth/me returns (and the identity\nthe IdP resolves). Char-pointer ULIDs, so plain strings on the wire.",
      "properties": {
        "account_id": {
          "description": "The user's primary account ULID.",
          "title": "Account Id",
          "type": "string"
        },
        "email": {
          "description": "The user's email address.",
          "title": "Email",
          "type": "string"
        },
        "id": {
          "description": "The user's cloud-issued ULID.",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "email",
        "account_id"
      ],
      "title": "AuthUser",
      "type": "object"
    },
    "Company": {
      "description": "One company from the central universe (seeded from the free PDL\nCompany Dataset, CC BY 4.0). Char-pointer ULID id.",
      "properties": {
        "country": {
          "description": "Country; empty when unknown.",
          "title": "Country",
          "type": "string"
        },
        "domain": {
          "description": "Canonical lowercased bare domain.",
          "title": "Domain",
          "type": "string"
        },
        "founded_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Founding year when known.",
          "title": "Founded Year"
        },
        "id": {
          "description": "The company's ULID in the universe.",
          "title": "Id",
          "type": "string"
        },
        "industry": {
          "description": "Industry label; empty when unknown.",
          "title": "Industry",
          "type": "string"
        },
        "linkedin_url": {
          "description": "LinkedIn company URL; empty when unknown.",
          "title": "Linkedin Url",
          "type": "string"
        },
        "locality": {
          "description": "City/locality; empty when unknown.",
          "title": "Locality",
          "type": "string"
        },
        "name": {
          "description": "Company display name.",
          "title": "Name",
          "type": "string"
        },
        "region": {
          "description": "Region/state; empty when unknown.",
          "title": "Region",
          "type": "string"
        },
        "size_band": {
          "description": "Coarse employee band, e.g. 1-10; empty when unknown.",
          "title": "Size Band",
          "type": "string"
        },
        "snapshot_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO date the row's data was current.",
          "title": "Snapshot Date"
        },
        "source": {
          "description": "Provenance of the row, e.g. pdl_free.",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "domain",
        "name",
        "industry",
        "locality",
        "region",
        "country",
        "linkedin_url",
        "size_band",
        "source"
      ],
      "title": "Company",
      "type": "object"
    },
    "FolderSummary": {
      "description": "A flat, account-scoped bucket for lists (taxonomy, not behavior).",
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "list_count": {
          "description": "Server-side count; consent copy must not trust loaded pages.",
          "title": "List Count",
          "type": "integer"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "list_count",
        "created_at",
        "updated_at"
      ],
      "title": "FolderSummary",
      "type": "object"
    },
    "FoldersList": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/FolderSummary"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "FoldersList",
      "type": "object"
    },
    "ImportResult": {
      "description": "What a CSV upload produced.",
      "properties": {
        "list": {
          "$ref": "#/$defs/ListSummary"
        },
        "rows": {
          "description": "Rows imported.",
          "title": "Rows",
          "type": "integer"
        },
        "skipped": {
          "description": "Blank lines and rows wider than the header, not imported.",
          "title": "Skipped",
          "type": "integer"
        }
      },
      "required": [
        "list",
        "rows",
        "skipped"
      ],
      "title": "ImportResult",
      "type": "object"
    },
    "ListColumn": {
      "properties": {
        "key": {
          "description": "Stable snake_case key; row data dicts key on it.",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "description": "Display label, as the user (or the CSV header) wrote it.",
          "title": "Label",
          "type": "string"
        },
        "type": {
          "description": "Sheet display type; drives rendering only.",
          "enum": [
            "text",
            "number",
            "currency",
            "date",
            "url",
            "email"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "type"
      ],
      "title": "ListColumn",
      "type": "object"
    },
    "ListRowWire": {
      "properties": {
        "data": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Cell values keyed by column key.",
          "title": "Data",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "position": {
          "description": "1-based dense display/paging order.",
          "title": "Position",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "position"
      ],
      "title": "ListRowWire",
      "type": "object"
    },
    "ListRowsPage": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ListRowWire"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The last position when more rows exist.",
          "title": "Next Cursor"
        }
      },
      "required": [
        "items"
      ],
      "title": "ListRowsPage",
      "type": "object"
    },
    "ListSummary": {
      "description": "One list as the index shows it (and the save-list response).",
      "properties": {
        "columns": {
          "default": [],
          "description": "Display order.",
          "items": {
            "$ref": "#/$defs/ListColumn"
          },
          "title": "Columns",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "folder_id": {
          "default": "",
          "description": "The containing folder; empty = loose at the root.",
          "title": "Folder Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "origin": {
          "description": "How the list came to exist.",
          "enum": [
            "discover",
            "csv",
            "manual"
          ],
          "title": "Origin",
          "type": "string"
        },
        "origin_ref": {
          "default": "",
          "description": "e.g. the source run id for discover snapshots.",
          "title": "Origin Ref",
          "type": "string"
        },
        "row_count": {
          "description": "Total rows (the sheet may page far beyond one response).",
          "title": "Row Count",
          "type": "integer"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "origin",
        "row_count",
        "created_at",
        "updated_at"
      ],
      "title": "ListSummary",
      "type": "object"
    },
    "ListsPage": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ListSummary"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The last id when more lists exist.",
          "title": "Next Cursor"
        }
      },
      "required": [
        "items"
      ],
      "title": "ListsPage",
      "type": "object"
    },
    "LookalikeGroup": {
      "description": "One seed group of a run: heterogeneous cohorts split into distinct\ngroups, each searched by its own centroid and labeled.",
      "properties": {
        "elbow_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "This group's own boundary: the knee of ITS score decay (null when too short/flat).",
          "title": "Elbow Rank"
        },
        "label": {
          "default": "",
          "description": "Human label; empty for the single homogeneous group.",
          "title": "Label",
          "type": "string"
        },
        "seed_domains": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Seed Domains",
          "type": "array"
        },
        "size": {
          "default": 0,
          "description": "Results this group contributed to the run.",
          "title": "Size",
          "type": "integer"
        }
      },
      "title": "LookalikeGroup",
      "type": "object"
    },
    "LookalikeItem": {
      "description": "One ranked look-alike candidate.",
      "properties": {
        "company": {
          "$ref": "#/$defs/Company"
        },
        "description": {
          "default": "",
          "description": "Site-derived blurb (homepage meta description or title); empty until the domain has a fetched snippet.",
          "title": "Description",
          "type": "string"
        },
        "group": {
          "default": "",
          "description": "Label of the seed group that surfaced this candidate; empty for single-group runs.",
          "title": "Group",
          "type": "string"
        },
        "rank": {
          "description": "1-based rank in this result set.",
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "description": "Similarity score in [0, 1].",
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "company",
        "score",
        "rank"
      ],
      "title": "LookalikeItem",
      "type": "object"
    },
    "LookalikeListResponse": {
      "description": "The look-alike envelope (data service and app proxy alike), for both\nthe query POST and the run-status poll.\n\n`status` drives the async lifecycle: \"complete\" carries the page in\n`items`; \"pending\"/\"running\" mean poll the run (HTTP 202, empty items);\n\"failed\" carries `detail`; \"canceled\" is terminal by request (a fresh\nquery revives the run). The engine computes in a worker, so a cold\ncohort answers pending first and is polled by `run_id`; a cached cohort\nanswers complete inline.",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Failure detail when status is failed.",
          "title": "Detail"
        },
        "engine": {
          "description": "Which engine ranked these, e.g. embedding_v1.",
          "title": "Engine",
          "type": "string"
        },
        "groups": {
          "default": [],
          "description": "The run's seed-group breakdown; single unlabeled entry for homogeneous cohorts.",
          "items": {
            "$ref": "#/$defs/LookalikeGroup"
          },
          "title": "Groups",
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/LookalikeItem"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque cursor for the next page.",
          "title": "Next Cursor"
        },
        "outlier_domains": {
          "default": [],
          "description": "Seeds set aside by clustering as misfits (excluded from generation, shown to the user).",
          "items": {
            "type": "string"
          },
          "title": "Outlier Domains",
          "type": "array"
        },
        "result_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "TOTAL results in the completed run (the full lead-list size, independent of page size).",
          "title": "Result Count"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The run to poll; null only when no run exists (e.g. an empty cohort).",
          "title": "Run Id"
        },
        "status": {
          "default": "complete",
          "description": "Run lifecycle. Terminal: complete | failed | canceled; keep polling: pending | running.",
          "enum": [
            "pending",
            "running",
            "complete",
            "failed",
            "canceled"
          ],
          "title": "Status",
          "type": "string"
        },
        "unresolved_domains": {
          "default": [],
          "description": "Inline seed domains that are not in the universe.",
          "items": {
            "type": "string"
          },
          "title": "Unresolved Domains",
          "type": "array"
        }
      },
      "required": [
        "engine",
        "items"
      ],
      "title": "LookalikeListResponse",
      "type": "object"
    },
    "RowsAdded": {
      "description": "The manual-append receipt.",
      "properties": {
        "added": {
          "title": "Added",
          "type": "integer"
        },
        "row_count": {
          "title": "Row Count",
          "type": "integer"
        }
      },
      "required": [
        "added",
        "row_count"
      ],
      "title": "RowsAdded",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenBower contract",
  "x-roots": [
    {
      "$ref": "#/$defs/AuthUser"
    },
    {
      "$ref": "#/$defs/Company"
    },
    {
      "$ref": "#/$defs/FoldersList"
    },
    {
      "$ref": "#/$defs/ImportResult"
    },
    {
      "$ref": "#/$defs/ListRowsPage"
    },
    {
      "$ref": "#/$defs/ListsPage"
    },
    {
      "$ref": "#/$defs/ListSummary"
    },
    {
      "$ref": "#/$defs/LookalikeItem"
    },
    {
      "$ref": "#/$defs/LookalikeListResponse"
    },
    {
      "$ref": "#/$defs/RowsAdded"
    }
  ]
}
