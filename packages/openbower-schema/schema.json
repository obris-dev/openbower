{
  "$defs": {
    "AgentCatalog": {
      "description": "What THIS deploy can run; search_available gates the tools.",
      "properties": {
        "contacts_available": {
          "title": "Contacts Available",
          "type": "boolean"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/CatalogModel"
          },
          "title": "Models",
          "type": "array"
        },
        "search_available": {
          "title": "Search Available",
          "type": "boolean"
        },
        "support_followup": {
          "description": "The deployment's needs-attention follow-up, profile-owned server-side (check the logs locally; the operator's support channel hosted). Client copy composes it instead of hedging about an operator it cannot identify.",
          "title": "Support Followup",
          "type": "string"
        },
        "truncated": {
          "description": "True when the catalog cap cut the list: an address past the cap may still RUN (model_for validates against the full roster), it just is not shown.",
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "models",
        "support_followup",
        "truncated",
        "search_available",
        "contacts_available"
      ],
      "title": "AgentCatalog",
      "type": "object"
    },
    "AgentConfig": {
      "description": "The runtime's interchange unit, shared by both custodies (a\nsaved agent, a column's quick prompt) and the test bench.",
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/AgentOutput"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Outputs",
          "type": "array"
        },
        "prompt": {
          "maxLength": 262144,
          "title": "Prompt",
          "type": "string"
        },
        "provider": {
          "enum": [
            "openai_compatible",
            "anthropic_compatible"
          ],
          "title": "Provider",
          "type": "string"
        },
        "source": {
          "description": "Which server of that spec (the env-named source).",
          "title": "Source",
          "type": "string"
        },
        "tools": {
          "$ref": "#/$defs/AgentTools"
        }
      },
      "required": [
        "prompt",
        "provider",
        "source",
        "model",
        "tools",
        "outputs"
      ],
      "title": "AgentConfig",
      "type": "object"
    },
    "AgentListItem": {
      "description": "One list row: the index ships what the table renders, never\neach agent's whole config (a full list of maxed prompts would be\nmegabytes to draw four columns; the edit page fetches its agent by\nid).",
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 128,
          "title": "Label",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "tools": {
          "$ref": "#/$defs/AgentTools"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "model",
        "tools",
        "created_at",
        "updated_at"
      ],
      "title": "AgentListItem",
      "type": "object"
    },
    "AgentOutput": {
      "description": "One declared output: a named, described field the model must\nfill (the description rides into the instruction), landing as one\ncell per row.",
      "properties": {
        "description": {
          "default": "",
          "maxLength": 256,
          "title": "Description",
          "type": "string"
        },
        "key": {
          "description": "Present always; BLANK allowed on requests (the server derives it from the label) and always populated on responses (required, no default: a response omitting it must fail the parse, never invent an empty string).",
          "maxLength": 40,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "description": "Non-blank on the wire (the server refuses blank labels at the request boundary); the builder's local draft may hold blank rows, client-side only.",
          "maxLength": 80,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "description": "Sheet display type; drives rendering only.",
          "enum": [
            "text",
            "number",
            "currency",
            "date",
            "url",
            "email"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "type"
      ],
      "title": "AgentOutput",
      "type": "object"
    },
    "AgentSummary": {
      "description": "A stored agent (one custody of a config).",
      "properties": {
        "config": {
          "$ref": "#/$defs/AgentConfig"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 128,
          "title": "Label",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "config",
        "created_at",
        "updated_at"
      ],
      "title": "AgentSummary",
      "type": "object"
    },
    "AgentTestResult": {
      "description": "One hand-fed row's outcome: the cells it would write (possibly\nempty, honestly), the evidence the model saw, and the searches that\nproduced it with each query's diagnosis.",
      "properties": {
        "cells": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Cells",
          "type": "object"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "searches": {
          "items": {
            "$ref": "#/$defs/TestSearch"
          },
          "title": "Searches",
          "type": "array"
        }
      },
      "required": [
        "cells",
        "evidence",
        "searches"
      ],
      "title": "AgentTestResult",
      "type": "object"
    },
    "AgentTestRun": {
      "description": "The polled test-run envelope: result rides only when complete,\nand a failed run carries its WHY (every empty result ships its\ndiagnosis; failure is the tier that needs it most).",
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "poll_budget_seconds": {
          "description": "The runtime's own worst case for one run: a poller waits this long (plus its margin) and no longer. The server presents runs still pending past its LARGER stale window as failed, so the loop normally ends on a terminal status.",
          "title": "Poll Budget Seconds",
          "type": "integer"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentTestResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "pending",
            "complete",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "poll_budget_seconds"
      ],
      "title": "AgentTestRun",
      "type": "object"
    },
    "AgentTools": {
      "description": "The tool REGISTRY, one typed field per tool: the wire itself\ncarries the key set, so the web derives its tool list from this\nshape instead of hand-retyping it. Unknown keys are TOLERATED\n(dropped) here because this model validates on every read, and a\nserver that adds a tool must not fail stored rows or a browser\nholding the old bundle; the REQUEST leg's serializer is where\nunknown keys refuse, which is what keeps the set closed on the\nway in.",
      "properties": {
        "find_contacts": {
          "default": false,
          "title": "Find Contacts",
          "type": "boolean"
        },
        "web_search": {
          "default": false,
          "title": "Web Search",
          "type": "boolean"
        }
      },
      "title": "AgentTools",
      "type": "object"
    },
    "AgentsList": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/AgentListItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "AgentsList",
      "type": "object"
    },
    "AuthUser": {
      "description": "The authenticated user the app's /v1/auth/me returns (and the identity\nthe IdP resolves). Char-pointer ULIDs, so plain strings on the wire.",
      "properties": {
        "account_id": {
          "description": "The user's primary account ULID.",
          "title": "Account Id",
          "type": "string"
        },
        "email": {
          "description": "The user's email address.",
          "title": "Email",
          "type": "string"
        },
        "id": {
          "description": "The user's cloud-issued ULID.",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "email",
        "account_id"
      ],
      "title": "AuthUser",
      "type": "object"
    },
    "CatalogModel": {
      "description": "One runnable model on this deploy.",
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "enum": [
            "openai_compatible",
            "anthropic_compatible"
          ],
          "title": "Provider",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "source",
        "model"
      ],
      "title": "CatalogModel",
      "type": "object"
    },
    "Company": {
      "description": "One company from the central universe (seeded from the free PDL\nCompany Dataset, CC BY 4.0). Char-pointer ULID id.",
      "properties": {
        "country": {
          "description": "Country; empty when unknown.",
          "title": "Country",
          "type": "string"
        },
        "domain": {
          "description": "Canonical lowercased bare domain.",
          "title": "Domain",
          "type": "string"
        },
        "founded_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Founding year when known.",
          "title": "Founded Year"
        },
        "id": {
          "description": "The company's ULID in the universe.",
          "title": "Id",
          "type": "string"
        },
        "industry": {
          "description": "Industry label; empty when unknown.",
          "title": "Industry",
          "type": "string"
        },
        "linkedin_url": {
          "description": "LinkedIn company URL; empty when unknown.",
          "title": "Linkedin Url",
          "type": "string"
        },
        "locality": {
          "description": "City/locality; empty when unknown.",
          "title": "Locality",
          "type": "string"
        },
        "name": {
          "description": "Company display name.",
          "title": "Name",
          "type": "string"
        },
        "region": {
          "description": "Region/state; empty when unknown.",
          "title": "Region",
          "type": "string"
        },
        "size_band": {
          "description": "Coarse employee band, e.g. 1-10; empty when unknown.",
          "title": "Size Band",
          "type": "string"
        },
        "snapshot_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO date the row's data was current.",
          "title": "Snapshot Date"
        },
        "source": {
          "description": "Provenance of the row, e.g. pdl_free.",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "domain",
        "name",
        "industry",
        "locality",
        "region",
        "country",
        "linkedin_url",
        "size_band",
        "source"
      ],
      "title": "Company",
      "type": "object"
    },
    "FolderSummary": {
      "description": "A flat, account-scoped bucket for lists (taxonomy, not behavior).",
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "list_count": {
          "description": "Server-side count; consent copy must not trust loaded pages.",
          "title": "List Count",
          "type": "integer"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "list_count",
        "created_at",
        "updated_at"
      ],
      "title": "FolderSummary",
      "type": "object"
    },
    "FoldersList": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/FolderSummary"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "FoldersList",
      "type": "object"
    },
    "ImportResult": {
      "description": "What a CSV upload produced.",
      "properties": {
        "list": {
          "$ref": "#/$defs/ListSummary"
        },
        "rows": {
          "description": "Rows imported.",
          "title": "Rows",
          "type": "integer"
        },
        "skipped": {
          "description": "Blank lines and rows wider than the header, not imported.",
          "title": "Skipped",
          "type": "integer"
        }
      },
      "required": [
        "list",
        "rows",
        "skipped"
      ],
      "title": "ImportResult",
      "type": "object"
    },
    "ListColumn": {
      "properties": {
        "key": {
          "description": "Stable snake_case key; row data dicts key on it.",
          "maxLength": 40,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "description": "Display label, as the user (or the CSV header) wrote it.",
          "maxLength": 80,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "description": "Sheet display type; drives rendering only.",
          "enum": [
            "text",
            "number",
            "currency",
            "date",
            "url",
            "email"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "type"
      ],
      "title": "ListColumn",
      "type": "object"
    },
    "ListRowWire": {
      "properties": {
        "data": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Cell values keyed by column key.",
          "title": "Data",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "position": {
          "description": "1-based dense display/paging order.",
          "title": "Position",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "position"
      ],
      "title": "ListRowWire",
      "type": "object"
    },
    "ListRowsPage": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ListRowWire"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The last position when more rows exist.",
          "title": "Next Cursor"
        }
      },
      "required": [
        "items"
      ],
      "title": "ListRowsPage",
      "type": "object"
    },
    "ListSummary": {
      "description": "One list as the index shows it (and the save-list response).",
      "properties": {
        "columns": {
          "default": [],
          "description": "Display order.",
          "items": {
            "$ref": "#/$defs/ListColumn"
          },
          "title": "Columns",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "folder_id": {
          "default": "",
          "description": "The containing folder; empty = loose at the root.",
          "title": "Folder Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "origin": {
          "description": "How the list came to exist.",
          "enum": [
            "discover",
            "csv",
            "manual"
          ],
          "title": "Origin",
          "type": "string"
        },
        "origin_ref": {
          "default": "",
          "description": "e.g. the source run id for discover snapshots.",
          "title": "Origin Ref",
          "type": "string"
        },
        "row_count": {
          "description": "Total rows (the sheet may page far beyond one response).",
          "title": "Row Count",
          "type": "integer"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "origin",
        "row_count",
        "created_at",
        "updated_at"
      ],
      "title": "ListSummary",
      "type": "object"
    },
    "ListsPage": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ListSummary"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The last id when more lists exist.",
          "title": "Next Cursor"
        }
      },
      "required": [
        "items"
      ],
      "title": "ListsPage",
      "type": "object"
    },
    "LookalikeGroup": {
      "description": "One seed group of a run: heterogeneous cohorts split into distinct\ngroups, each searched by its own centroid and labeled.",
      "properties": {
        "elbow_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "This group's own boundary: the knee of ITS score decay (null when too short/flat).",
          "title": "Elbow Rank"
        },
        "label": {
          "default": "",
          "description": "Human label; empty for the single homogeneous group.",
          "title": "Label",
          "type": "string"
        },
        "seed_domains": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Seed Domains",
          "type": "array"
        },
        "size": {
          "default": 0,
          "description": "Results this group contributed to the run.",
          "title": "Size",
          "type": "integer"
        }
      },
      "title": "LookalikeGroup",
      "type": "object"
    },
    "LookalikeItem": {
      "description": "One ranked look-alike candidate.",
      "properties": {
        "company": {
          "$ref": "#/$defs/Company"
        },
        "description": {
          "default": "",
          "description": "Site-derived blurb (homepage meta description or title); empty until the domain has a fetched snippet.",
          "title": "Description",
          "type": "string"
        },
        "group": {
          "default": "",
          "description": "Label of the seed group that surfaced this candidate; empty for single-group runs.",
          "title": "Group",
          "type": "string"
        },
        "rank": {
          "description": "1-based rank in this result set.",
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "description": "Similarity score in [0, 1].",
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "company",
        "score",
        "rank"
      ],
      "title": "LookalikeItem",
      "type": "object"
    },
    "LookalikeListResponse": {
      "description": "The look-alike envelope (data service and app proxy alike), for both\nthe query POST and the run-status poll.\n\n`status` drives the async lifecycle: \"complete\" carries the page in\n`items`; \"pending\"/\"running\" mean poll the run (HTTP 202, empty items);\n\"failed\" carries `detail`; \"canceled\" is terminal by request (a fresh\nquery revives the run). The engine computes in a worker, so a cold\ncohort answers pending first and is polled by `run_id`; a cached cohort\nanswers complete inline.",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Failure detail when status is failed.",
          "title": "Detail"
        },
        "engine": {
          "description": "Which engine ranked these, e.g. embedding_v1.",
          "title": "Engine",
          "type": "string"
        },
        "groups": {
          "default": [],
          "description": "The run's seed-group breakdown; single unlabeled entry for homogeneous cohorts.",
          "items": {
            "$ref": "#/$defs/LookalikeGroup"
          },
          "title": "Groups",
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/LookalikeItem"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque cursor for the next page.",
          "title": "Next Cursor"
        },
        "outlier_domains": {
          "default": [],
          "description": "Seeds set aside by clustering as misfits (excluded from generation, shown to the user).",
          "items": {
            "type": "string"
          },
          "title": "Outlier Domains",
          "type": "array"
        },
        "result_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "TOTAL results in the completed run (the full lead-list size, independent of page size).",
          "title": "Result Count"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The run to poll; null only when no run exists (e.g. an empty cohort).",
          "title": "Run Id"
        },
        "status": {
          "default": "complete",
          "description": "Run lifecycle. Terminal: complete | failed | canceled; keep polling: pending | running.",
          "enum": [
            "pending",
            "running",
            "complete",
            "failed",
            "canceled"
          ],
          "title": "Status",
          "type": "string"
        },
        "unresolved_domains": {
          "default": [],
          "description": "Inline seed domains that are not in the universe.",
          "items": {
            "type": "string"
          },
          "title": "Unresolved Domains",
          "type": "array"
        }
      },
      "required": [
        "engine",
        "items"
      ],
      "title": "LookalikeListResponse",
      "type": "object"
    },
    "RowsAdded": {
      "description": "The manual-append receipt.",
      "properties": {
        "added": {
          "title": "Added",
          "type": "integer"
        },
        "row_count": {
          "title": "Row Count",
          "type": "integer"
        }
      },
      "required": [
        "added",
        "row_count"
      ],
      "title": "RowsAdded",
      "type": "object"
    },
    "TestSearch": {
