# Origins the browser bundle calls. Baked in at BUILD time (NEXT_PUBLIC_*
# is inlined by next build): set them in the build environment, not just
# at runtime. Unset in production the app throws at startup; in local
# they fall back to the localhost ports below.
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_AUTH_URL=http://localhost:8001
