# The origins the production build talks to. NEXT_PUBLIC_* is inlined
# at build time, so the deploy build (`pnpm cf-deploy`) reads this file;
# `next dev` does not, and keeps its localhost fallbacks. The Docker
# image never sees it (the context excludes env files) and takes the
# same two values as build arguments instead. A self-hoster deploying
# their own copy of the app points these at their own hosts.
NEXT_PUBLIC_API_URL=https://api.openbower.ai
NEXT_PUBLIC_AUTH_URL=https://auth.openbower.ai
