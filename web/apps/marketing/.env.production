# The origins the production build links out to. NEXT_PUBLIC_* is inlined
# at build time, so the deploy build (`pnpm cf-deploy`) reads this file;
# `next dev` does not, and keeps its localhost fallbacks. A self-hoster
# deploying their own copy of the site points these at their own hosts.
NEXT_PUBLIC_AUTH_URL=https://auth.openbower.ai
NEXT_PUBLIC_APP_URL=https://app.openbower.ai
NEXT_PUBLIC_API_URL=https://api.openbower.ai
